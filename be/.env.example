# ============================================================
# Salin file ini menjadi .env di folder be/
#   cp .env.example .env
# .env dimuat otomatis oleh dotenv (lihat src/lib/env.ts).
# ============================================================

# Database
DATABASE_URL="postgresql://absen:absen@localhost:5432/absen_sekolah?schema=public"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
SCHOOL_TIMEZONE=Asia/Jakarta

# Auth (dashboard)
# Format: <angka><s|m|h|d>, contoh 15m / 7d. Jangan hapus satuannya.
JWT_ACCESS_SECRET="dev-access-secret-change-me-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Frontend origin untuk CORS
CORS_ORIGIN="http://localhost:3000"

# Device
DEVICE_RATE_LIMIT_PER_MINUTE=60
